{
  "cues": [
    {
      "text": "这是时间窗的空间关系示意。",
      "start": 0.15,
      "end": 2.85
    },
    {
      "text": "画框拉开，保留同一个观察者。",
      "start": 3.15,
      "end": 5.85
    },
    {
      "text": "同一批事件不一定等间隔出现。",
      "start": 6.15,
      "end": 8.85
    },
    {
      "text": "事件位置按照输入数据改变。",
      "start": 9.15,
      "end": 11.85
    },
    {
      "text": "每个样本进入自己对应的分类。",
      "start": 12.15,
      "end": 14.85
    },
    {
      "text": "柱形数量由样本自动计数。",
      "start": 15.15,
      "end": 17.85
    },
    {
      "text": "比较必须使用同一种计量单位。",
      "start": 18.15,
      "end": 20.85
    },
    {
      "text": "两个窗口移动到同一位置再分开。",
      "start": 21.15,
      "end": 23.85
    },
    {
      "text": "推导要保留每一项的身份。",
      "start": 24.15,
      "end": 26.85
    },
    {
      "text": "只消去这一步允许消去的项。",
      "start": 27.15,
      "end": 29.85
    },
    {
      "text": "曲线按给定的数据点逐步展开。",
      "start": 30.15,
      "end": 32.85
    },
    {
      "text": "坐标范围由同一份数据决定。",
      "start": 33.15,
      "end": 35.85
    },
    {
      "text": "每个对象依次通过筛选条件。",
      "start": 36.15,
      "end": 38.85
    },
    {
      "text": "不满足条件的对象停在对应门前。",
      "start": 39.15,
      "end": 41.85
    }
  ],
