    {
      "id": "user-content-feedback",
      "kind": "user-feedback",
      "label": "用户多轮内容反馈，概括",
      "observations": [
        "认可部分视觉方向后仍认为选题不好、内容偏薄，要求更深、更快、更专业。",
        "组件可复用与技术运行不能证明成片值得持续观看。"
      ],
      "scope": "用户问题反馈，不是某个新修复已通过的记录。"
    },
    {
      "id": "user-music-feedback",
      "kind": "user-feedback",
      "label": "用户纠正原声只有约6.2秒的判断，概括",
      "observations": [
        "已取到的短音频不代表完整作品的配乐长度；需查完整视频、音乐条目和实际音轨。"
      ],
      "scope": "不附原视频或音乐。"
    },
    {
      "id": "user-operating-preferences",
      "kind": "user-feedback",
      "label": "本项目已明确的操作偏好，概括",
      "observations": [
        "静音预览，不外放。",
        "用户已手动验证既有编辑器流程，不重复要求。",
        "保留旧版本；方向认可不扩展为整片认可。"
      ],
      "scope": "其他用户的偏好须由当前会话确认，不能套用其编辑器验收。"
    },
    {
      "id": "user-diversity-request",
      "kind": "user-requirement",
      "label": "2026-10-24：保留多样性、按需经验读取、强模型主创",
      "observations": [
        "支持不同文章、风格、时长、剪辑和内容形式。",
        "复用既有人工介入与修复经验，不从零重画；主要制作继续使用用户选择的强模型。"
      ],
      "scope": "新需求与设计依据，不是多样组合已验证的证据。"
    },
    {
      "id": "user-temp-feedback",
      "kind": "user-reported-environment-fix",
      "label": "2026-10-25：Windows Remotion临时目录权限反馈",
      "observations": [
        "Remotion调用的FFmpeg在%TEMP%下写pre-encode.mp4时报Permission denied。",
        "用户将TEMP/TMP指向工程/.tmp后通过，并记入其README。"
      ],
      "scope": "用户实测成功的处理方法；本次Agent未复现原故障，不推断适用于所有权限错误。"
    },
    {
      "id": "cross-agent-visual-gap",
      "kind": "local-artifact-review-and-user-feedback",
      "label": "2026-10-25：独立Agent短片复现暴露的视觉落地缺口",
      "observations": [
        "复用了字体、配音和渲染骨架，但没有接入主要视觉组件。",
        "分镜中的对象变形实际是清空后淡入；数值同源声明只部分落实。",
        "静帧审看没有验证跨镜动作，技术与记录通过不能证明观感。"
      ],
      "scope": "对一个独立复现案例的核查；通用结论保留，原片不并入此更新。",
      "files": [
        "references/executable-production.md"
      ]
    },
