  "cues": [
    {
      "text": "给你一百元",
      "start": 0.696291,
      "end": 1.518041
    },
    {
      "text": "先跌百分之五十",
      "start": 2.035166,
      "end": 3.389333
    },
    {
      "text": "再涨百分之五十",
      "start": 3.551375,
      "end": 4.847665999999999
    },
    {
      "text": "你觉得，能回本吗",
      "start": 5.380083,
      "end": 7.1624989999999995
    },
    {
      "text": "看，先拿走一半",
      "start": 7.683332999999999,
      "end": 9.315291
    },
    {
      "text": "只剩五十",
      "start": 9.604625,
      "end": 10.495832
    },
    {
      "text": "接下来上涨的一半",
      "start": 11.02825,
      "end": 12.266665999999999
    },
    {
      "text": "是这五十的一半",
      "start": 12.486583,
      "end": 13.505082
    },
    {
      "text": "二十五",
      "start": 13.852333,
      "end": 14.442624
    },
    {
      "text": "补回去，只有七十五",
      "start": 14.963416,
      "end": 16.595374
    },
    {
      "text": "少掉的二十五，藏在哪儿",
      "start": 17.127791000000002,
      "end": 19.049082000000002
    },
    {
      "text": "那就反过来",
      "start": 19.569916000000003,
      "end": 20.380082
    },
    {
      "text": "先涨一半",
      "start": 20.9125,
      "end": 21.653249000000002
    },
    {
      "text": "一百变一百五十",
      "start": 21.977333,
      "end": 23.111541000000003
    },
    {
      "text": "再跌一半",
      "start": 23.644000000000002,
      "end": 24.373125
    },
    {
      "text": "剩下的，还是七十五",
      "start": 24.650916000000002,
      "end": 26.398625000000003
    },
    {
      "text": "顺序换了，终点没变",
      "start": 26.931,
      "end": 28.782874000000003
    },
    {
      "text": "因为百分比不是固定的钱数",
      "start": 29.292125000000002,
      "end": 31.097707
    },
    {
      "text": "它每次都从当时的本金开始算",
      "start": 31.468041000000003,
      "end": 33.366207
    },
    {
      "text": "再看回本",
      "start": 33.887041,
      "end": 34.546749
    },
    {
      "text": "五十要回到一百",
      "start": 35.009708,
      "end": 36.167124
    },
    {
      "text": "得再赚五十",
      "start": 36.387041,
      "end": 37.301374
    },
    {
      "text": "相对于剩下的五十",
      "start": 37.833791,
      "end": 39.245833000000005
    },
    {
      "text": "这叫上涨百分之一百",
      "start": 39.454166,
      "end": 40.808332
    },
    {
      "text": "两个看起来一样的百分之五十",
      "start": 41.34075,
      "end": 43.296749
    },
    {
      "text": "第一次对应五十",
      "start": 43.667125,
      "end": 44.789833
    },
    {
      "text": "第二次却只对应二十五",
      "start": 44.998166000000005,
      "end": 46.757416
    },
    {
      "text": "看懂涨跌",
      "start": 47.289833,
      "end": 48.099999000000004
    },
    {
      "text": "先看它站在哪个本金上",
