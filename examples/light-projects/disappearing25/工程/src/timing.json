{
  "cues": [
    {
      "i": 1,
      "text": "给你一百元",
      "start": 0.7077259369070209,
      "end": 1.627061997944339
    },
    {
      "i": 2,
      "text": "先跌百分之五十",
      "start": 2.2055976359898795,
      "end": 3.720577320524985
    },
    {
      "i": 3,
      "text": "再涨百分之五十",
      "start": 3.901862448608476,
      "end": 5.352093129348513
    },
    {
      "i": 4,
      "text": "你觉得，能回本吗",
      "start": 5.947736752846301,
      "end": 7.941821699082859
    },
    {
      "i": 5,
      "text": "看，先拿走一半",
      "start": 8.524506795540798,
      "end": 10.350266259487668
    },
    {
      "i": 6,
      "text": "只剩五十",
      "start": 10.673959815781153,
      "end": 11.671001170145479
    },
    {
      "i": 7,
      "text": "接下来上涨的一半",
      "start": 12.266645912397218,
      "end": 13.652128708096143
    },
    {
      "i": 8,
      "text": "是这五十的一半",
      "start": 13.898161721220747,
      "end": 15.037611503795068
    },
    {
      "i": 9,
      "text": "二十五",
      "start": 15.426099932795701,
      "end": 16.086490322580648
    },
    {
      "i": 10,
      "text": "补回去，只有七十五",
      "start": 16.669128431372553,
      "end": 18.494887895319422
    },
    {
      "i": 11,
      "text": "少掉的二十五，藏在哪儿",
      "start": 19.090531518817208,
      "end": 21.23998342030361
    },
    {
      "i": 12,
      "text": "那就反过来",
      "start": 21.82266851676155,
      "end": 22.729044932005063
    },
    {
      "i": 13,
      "text": "先涨一半",
      "start": 23.324689674256803,
      "end": 24.15340554633144
    },
    {
      "i": 14,
      "text": "一百变一百五十",
      "start": 24.515975802498424,
      "end": 25.78487548624289
    },
    {
      "i": 15,
      "text": "再跌一半",
      "start": 26.38056609740671,
      "end": 27.196277573529418
    },
    {
      "i": 16,
      "text": "剩下的，还是七十五",
      "start": 27.50705735294118,
      "end": 29.46231370572423
    },
    {
      "i": 17,
      "text": "顺序换了，终点没变",
      "start": 30.05791034155598,
      "end": 32.1297016998735
    },
    {
      "i": 18,
      "text": "因为百分比不是固定的钱数",
      "start": 32.699428269291595,
      "end": 34.71943026960785
    },
    {
      "i": 19,
      "text": "它每次都从当时的本金开始算",
      "start": 35.133742896110064,
      "end": 37.25732361242885
    },
    {
      "i": 20,
      "text": "再看回本",
      "start": 37.84000870888679,
      "end": 38.57805964184061
    },
    {
      "i": 21,
      "text": "五十要回到一百",
      "start": 39.09599685325744,
      "end": 40.390860578747635
    },
    {
      "i": 22,
      "text": "得再赚五十",
      "start": 40.636893591872244,
      "end": 41.65980725015814
    },
    {
      "i": 23,
      "text": "相对于剩下的五十",
      "start": 42.25545087365592,
      "end": 43.83517844323214
    },
    {
      "i": 24,
      "text": "这叫上涨百分之一百",
      "start": 44.06825181056294,
      "end": 45.58323037634409
    },
    {
      "i": 25,
      "text": "两个看起来一样的百分之五十",
      "start": 46.17887511859583,
      "end": 48.36715673228969
    },
    {
      "i": 26,
      "text": "第一次对应五十",
      "start": 48.78151634645794,
      "end": 50.03755035974068
    },
    {
      "i": 27,
      "text": "第二次却只对应二十五",
      "start": 50.27062372707149,
      "end": 52.238791619228344
    },
    {
      "i": 28,
      "text": "看懂涨跌",
      "start": 52.83443524272613,
      "end": 53.74081165796965
    },
    {
      "i": 29,
      "text": "先看它站在哪个本金上",
      "start": 54.07746374130298,
      "end": 56.29171163425048
    }
  ],
